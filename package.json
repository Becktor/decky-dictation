  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "^18.3.3",
    "rollup": "^4.53.3",
    "shx": "^0.3.4",
    "tslib": "^2.7.0",
    "typescript": "^5.6.2"
  },
